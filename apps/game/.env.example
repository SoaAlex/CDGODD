# Copy to .env for local overrides. All EXPO_PUBLIC_* vars are baked into
# the client bundle at build time — never put secrets here.

# API origin (defaults to http://localhost:8787 in dev).
EXPO_PUBLIC_API_URL=

# AdMob ids are NOT env vars: the app ids (ca-app-pub-…~…) live in app.json
# (plugin config) and the per-platform unit ids are hardcoded in src/ads/
# (public by design; dev builds always use Google's test units via __DEV__).

# Web ad network: `h5` (Google H5 Games Ads, the default) or `adsterra` (the
# fallback). Each needs its own settings below; without them the web version
# is ad-free.
EXPO_PUBLIC_WEB_AD_NETWORK=

# Google H5 Games Ads: the AdSense publisher id (ca-pub-…). Set H5_ADS_TEST to
# `on` for Google's fake ads, always when testing: clicking real ads during
# testing is AdSense policy abuse.
EXPO_PUBLIC_ADSENSE_CLIENT=
EXPO_PUBLIC_H5_ADS_TEST=

# Adsterra banner units: the script URL from each unit's code snippet in the
# Adsterra dashboard, e.g. https://bauval.org/22/<key> (the unit key is read
# from it).
# 320x50 banner (bottom of the home page).
EXPO_PUBLIC_ADSTERRA_SRC_BANNER=
# 160x600 skyscraper (desktop side rails on swipe screens).
EXPO_PUBLIC_ADSTERRA_SRC_SIDE=

# Cloudflare Turnstile site key (web). Empty = dev placeholder token,
# which the API accepts only when TURNSTILE_SECRET is not configured.
EXPO_PUBLIC_TURNSTILE_SITEKEY=
